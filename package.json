{
  "name": "@princenedjoh/envsync",
  "version": "0.1.0",
  "description": "Validate .env files against .env.example, keep them in sync, and check every app in a monorepo.",
  "keywords": [
    "env",
    "dotenv",
    "cli",
    "monorepo",
    "validate",
    "sync",
    "lint",
    "gitignore",
    "secrets"
  ],
  "homepage": "https://github.com/princenedjoh/envsync#readme",
  "bugs": {
    "url": "https://github.com/princenedjoh/envsync/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/princenedjoh/envsync.git"
  },
  "license": "MIT",
  "author": "Prince Nedjoh (https://github.com/princenedjoh)",
  "type": "module",
  "bin": {
    "envsync": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "vitest": "^4.1.12"
  }
}
